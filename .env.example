# MimmiFlowers Client — Environment Variables (Vite)
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in real values.
#
# For Docker builds, these are passed as build args instead (see docker-compose).
# For local `npm run dev`, Vite reads from the .env.* file matching the mode.

# Base URL for the API server.
# - For Docker (nginx proxies to server): leave empty (same origin)
# - For local dev without Docker: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Stripe publishable key
VITE_STRIPE_PUBLIC_KEY=pk_test_...
